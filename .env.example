# Klook direct affiliate (affiliate.klook.com). One id tracks every destination,
# because Klook attributes on an `aid` appended to any Klook product URL.
NEXT_PUBLIC_KLOOK_AFFILIATE_ID=

# Optional per-destination overrides, only needed if a specific tracking URL
# must be used instead of the product page. These win over the id above.
NEXT_PUBLIC_KLOOK_AFFILIATE_URL=
NEXT_PUBLIC_KLOOK_AFFILIATE_URL_UNITED_STATES=
NEXT_PUBLIC_KLOOK_AFFILIATE_URL_SPAIN=
NEXT_PUBLIC_KLOOK_AFFILIATE_URL_JAPAN=
NEXT_PUBLIC_KLOOK_AFFILIATE_URL_UAE=

# Nomad affiliate links. Dormant until set: without these, Nomad links point at
# its public pages and Nomad is not marked as an affiliate. Set the first one
# alone if you have a single tracking link rather than per-destination links.
# The link's host must be listed in NOMAD_TRACKING_HOSTS in lib/destinations.ts.
NEXT_PUBLIC_NOMAD_AFFILIATE_URL=
NEXT_PUBLIC_NOMAD_AFFILIATE_URL_UNITED_STATES=
NEXT_PUBLIC_NOMAD_AFFILIATE_URL_SPAIN=
NEXT_PUBLIC_NOMAD_AFFILIATE_URL_JAPAN=
NEXT_PUBLIC_NOMAD_AFFILIATE_URL_UAE=

# Saily partners API. Both values are required together; without them the site
# falls back to the dated manual snapshots and no affiliate link is emitted.
# These are server-only and must never be prefixed with NEXT_PUBLIC_.
SAILY_AFF_ID=
SAILY_OFFER_ID=
